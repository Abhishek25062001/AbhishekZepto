{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist-catalog-test",
    "noEmit": false,
    "rootDir": "src",
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": [
    "src/access-control/**/*.ts",
    "src/modules/catalog/constants/**/*.ts",
    "src/modules/catalog/forms/**/*.schema.ts",
    "src/modules/catalog/forms/**/*.test.ts",
    "src/modules/catalog/utils/catalog-*.ts"
  ]
}

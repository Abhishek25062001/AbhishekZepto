    "test:phase-3": "npm run test:categories && npm run test:brands && npm run test:units && npm run test:products && npm run test:variants && npm run test:cities && npm run test:service-areas && npm run test:stores && npm run test:store-products && npm run test:inventory && npm run test:inventory-locks && npm run test:media && npm run test:catalog-search",
    "test:products": "npm run build && node --test dist/modules/catalog/products/services/product.service.test.js dist/modules/catalog/products/controllers/product.controller.test.js",

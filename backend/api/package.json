    "test:tenant-scope": "npm run build && node --test dist/database/tenant-query-helpers.test.js dist/validators/tenant.validators.test.js dist/modules/auth/services/scope-access.service.test.js dist/modules/auth/middlewares/scope-guards.middleware.test.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "seed": "ts-node src/database/seeds/index.ts",
    "seed:dry": "ts-node src/database/seeds/index.ts --dry-run"

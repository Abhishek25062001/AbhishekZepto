    "test:seed-matrix": "npm run build && node --test dist/database/seeds/seed-role-permission-matrix.test.js",
    "test:seeds": "npm run build && node --test dist/database/seeds/seed-catalog.test.js dist/database/seeds/seed-store-inventory.test.js dist/database/seeds/seed-role-permission-matrix.test.js",

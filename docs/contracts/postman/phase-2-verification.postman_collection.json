      "item": [
        {
          "name": "Request OTP - customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.challengeId) {",
                  "  pm.collectionVariables.set('challengeId', json.data.challengeId);",
                  "}",
                  "pm.test('Status is success', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test('Response has success envelope', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('success', true);",
                  "});",
                  "pm.test('Response does not expose refreshTokenHash', function () {",
                  "  pm.expect(pm.response.text()).to.not.include('refreshTokenHash');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/public/auth/request-otp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{customerPhone}}\",\n  \"role\": \"customer\",\n  \"purpose\": \"login\",\n  \"deliveryChannel\": \"sms\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Verify OTP - customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code >= 200 && pm.response.code < 300 && json && json.data) {",
                  "  if (json.data.accessToken) pm.collectionVariables.set('customerAccessToken', json.data.accessToken);",
                  "  if (json.data.refreshToken) pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "  const user = json.data.user || {};",
                  "  if (user.userId) pm.collectionVariables.set('testUserId', user.userId);",
                  "  if (json.data.session && json.data.session.sessionId) {",
                  "    pm.collectionVariables.set('testSessionId', json.data.session.sessionId);",
                  "  } else if (json.data.sessions && json.data.sessions[0] && json.data.sessions[0].sessionId) {",
                  "    pm.collectionVariables.set('testSessionId', json.data.sessions[0].sessionId);",
                  "  }",
                  "  if (user.userId) pm.collectionVariables.set('customerId', user.userId);",
                  "}",
                  "pm.test('Status is success', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test('Response has success envelope', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('success', true);",
                  "});",
                  "pm.test('Response does not expose refreshTokenHash', function () {",
                  "  pm.expect(pm.response.text()).to.not.include('refreshTokenHash');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"

{
  "name": "@zepto-like/delivery-agent-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:access-control-smoke": "tsc -p tsconfig.smoke.json && node --test dist-access-control-smoke/*.smoke.test.js",
    "test:realtime-operations": "tsc -p tsconfig.realtime-operations-test.json && find dist-realtime-operations-test/apps/delivery-agent-app/src/modules/realtime-operations -name '*.test.js' -exec node --test {} + && node --test dist-realtime-operations-test/apps/delivery-agent-app/src/tests/integration/phase-7-delivery-realtime.test.js",
    "test:push-notifications": "tsc -p tsconfig.push-notifications-test.json && find dist-push-notifications-test/apps/delivery-agent-app/src -name '*.test.js' -exec node --test {} +",
    "test:notifications": "tsc -p tsconfig.notifications-test.json && find dist-notifications-test/apps/delivery-agent-app/src/modules/notification-center -name '*.test.js' -exec node --test {} +",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/messaging": "^24.0.0",
    "@react-navigation/core": "^7.17.5",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.14.14",
    "@tanstack/react-query": "^5.100.9",
    "axios": "^1.16.0",
    "react": "19.2.3",
    "react-hook-form": "^7.75.0",
    "react-native": "^0.85.3",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0",
    "socket.io-client": "^4.8.3",
    "zod": "^3.25.76",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.1.3",
    "@react-native/metro-config": "^0.85.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.14"
  }
}
